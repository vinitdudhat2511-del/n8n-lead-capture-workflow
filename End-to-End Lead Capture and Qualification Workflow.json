    {
      "parameters": {
        "jsCode": "const lead = $('Check Duplicate').first().json;\n\nlet aiScore = 5;\nlet aiNotes = '';\ntry {\n  const aiItem = $input.first();\n  const aiText = (aiItem.json.message && aiItem.json.message.content) || aiItem.json.text || '';\n  const match = String(aiText).match(/\\d+/);\n  aiScore = match ? Math.min(10, Math.max(1, parseInt(match[0]))) : 5;\n  aiNotes = String(aiText).slice(0, 200);\n} catch (e) {\n  aiScore = 5;\n  aiNotes = 'AI scoring unavailable';\n}\n\nconst highBudget = lead.budget >= 50000;\nconst mediumBudget = lead.budget >= 15000 && lead.budget < 50000;\n\nlet tier = 'Cold';\nif (highBudget && lead.isCorporateEmail) {\n  tier = 'Hot';\n} else if ((mediumBudget || !lead.isCorporateEmail) && lead.isDataComplete && aiScore >= 4) {\n  tier = 'Warm';\n} else {\n  tier = 'Cold';\n}\n\nreturn [{\n  json: {\n    ...lead,\n    aiIntentScore: aiScore,\n    aiNotes,\n    tier\n  }\n}];"
      },
