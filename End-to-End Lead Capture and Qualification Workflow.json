      "parameters": {
        "jsCode": "const originalLead = $('Validate & Clean Data').first().json;\nconst lookupResults = $input.all().filter(item => item.json && item.json.Email);\n\nreturn [{\n  json: {\n    ...originalLead,\n    isDuplicate: lookupResults.length > 0\n  }\n}];"
      },
