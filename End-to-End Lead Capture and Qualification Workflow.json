    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst freeEmailDomains = ['gmail.com','yahoo.com','yahoo.co.in','hotmail.com','outlook.com','aol.com','icloud.com','protonmail.com','rediffmail.com'];\n\nreturn items.map(item => {\n  const raw = item.json.body || item.json;\n\n  const name = (raw.name || '').toString().trim();\n  const email = (raw.email || '').toString().trim().toLowerCase();\n  const phone = (raw.phone || '').toString().trim();\n  const company = (raw.company || '').toString().trim();\n  const budget = Number(raw.budget) || 0;\n  const source = (raw.source || '').toString().trim();\n\n  const errors = [];\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!name) errors.push('Missing name');\n  if (!email || !emailRegex.test(email)) errors.push('Missing or invalid email');\n  if (!phone) errors.push('Missing phone');\n  if (!source) errors.push('Missing source');\n\n  const domain = email.includes('@') ? email.split('@')[1] : '';\n  const isCorporateEmail = !!domain && !freeEmailDomains.includes(domain);\n  const isDataComplete = !!(name && email && phone && company && source);\n\n  return {\n    json: {\n      name, email, phone, company, budget, source, domain,\n      isCorporateEmail,\n      isDataComplete,\n      isValid: errors.length === 0,\n      validationErrors: errors,\n      submittedAt: new Date().toISOString()\n    }\n  };\n});"
      },
