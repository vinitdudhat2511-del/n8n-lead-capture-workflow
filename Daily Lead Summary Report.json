    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst today = new Date().toISOString().slice(0, 10);\nconst todaysRows = rows.filter(r => (r.Timestamp || '').toString().slice(0, 10) === today);\n\nconst counts = { Hot: 0, Warm: 0, Cold: 0 };\nfor (const r of todaysRows) {\n  if (counts[r.Tier] !== undefined) counts[r.Tier]++;\n}\n\nconst summaryText = `Daily Lead Summary — ${today}\\n\\nTotal new leads: ${todaysRows.length}\\nHot: ${counts.Hot}\\nWarm: ${counts.Warm}\\nCold: ${counts.Cold}`;\n\nreturn [{ json: { date: today, total: todaysRows.length, ...counts, summaryText } }];"
      },
